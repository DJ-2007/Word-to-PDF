# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production

# File Limits & Retention
MAX_FREE_FILE_SIZE=52428800 # 50 MB in bytes
MAX_BATCH_FILES=20
FILE_RETENTION_HOURS=24
CONVERSION_TIMEOUT_MS=60000 # 60 seconds

# Storage Directory
TEMP_STORAGE_DIR=.temp_storage

# System Binaries / Runtimes
PYTHON_PATH=python
EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
LIBREOFFICE_PATH=soffice

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# Optional Database & Storage (For cloud production deployments)
# DATABASE_URL=postgresql://user:password@localhost:5432/convertly
# REDIS_URL=redis://localhost:6379
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=convertly-storage
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
